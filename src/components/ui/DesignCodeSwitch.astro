---
// Flips a screen between its Figma design and its coded version (spec 0002, AC-8).
// Exactly one button is pressed; a change dispatches `designcode:change` with { value } on the switch.
interface Props {
  value?: 'design' | 'code';
  label?: string;
}

const { value = 'design', label = 'Show this screen as' } = Astro.props;

const options = [
  { value: 'design', text: 'Design' },
  { value: 'code', text: 'Code' },
] as const;
---

<div class="design-code inline-flex" role="group" aria-label={label} data-design-code data-value={value}>
  {
    options.map((option) => (
      <button
        type="button"
        class="design-code-option min-h-11 px-5 text-body font-semibold"
        aria-pressed={option.value === value ? 'true' : 'false'}
        data-value={option.value}
      >
        {option.text}
      </button>
    ))
  }
</div>

<style>
  .design-code-option {
    background-color: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--duration-feedback) var(--ease-page),
      color var(--duration-feedback) var(--ease-page),
      box-shadow var(--duration-feedback) var(--ease-page);
  }

  /* Keep the focus ring above the neighbouring button. */
  .design-code-option:focus-visible {
    position: relative;
    z-index: 1;
  }

  .design-code-option[aria-pressed='false']:hover {
    box-shadow: inset 0 calc(var(--size-ledge) * -1) 0 0 var(--color-ink);
  }

  .design-code-option[aria-pressed='true'] {
    background-color: var(--color-ink);
    color: var(--color-bg);
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-design-code]').forEach((group) => {
    const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-value]');

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const value = button.dataset.value;
        if (!value || value === group.dataset.value) return;

        group.dataset.value = value;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        group.dispatchEvent(new CustomEvent('designcode:change', { detail: { value }, bubbles: true }));
      }),
    );
  });
</script>
