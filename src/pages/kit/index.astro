---
import Button from '../../components/ui/Button.astro';
import DesignCodeSwitch from '../../components/ui/DesignCodeSwitch.astro';
import Field from '../../components/ui/Field.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import Link from '../../components/ui/Link.astro';
import ThemeToggle from '../../components/ui/ThemeToggle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudyMeta, getSiteCaseStudies } from '../../lib/content';

// Internal reference page (spec 0002, AC-13): noindex, not linked from the site.
// `data-state` shows hover, pressed, and focus without a pointer; the real pieces respond to it too.
const themes = ['light', 'dark'] as const;

const colours = [
  { token: 'bg', light: '#ffffff', dark: '#121212', use: 'Page ground' },
  { token: 'surface', light: '#f4f4f4', dark: '#1e1e1e', use: 'Panels and fields' },
  { token: 'ink', light: '#111111', dark: '#f2f2f2', use: 'Text and headings' },
  { token: 'muted', light: '#6b6b6b', dark: '#a0a0a0', use: 'Secondary notes' },
  { token: 'accent', light: '#1a4be0', dark: '#6b8cff', use: 'Main button and links' },
  { token: 'accent-ink', light: '#ffffff', dark: '#111111', use: 'Text on accent' },
  { token: 'stage', light: '#111111', dark: '#000000', use: 'Stage field' },
  { token: 'stage-ink', light: '#ffffff', dark: '#f2f2f2', use: 'Text on stage' },
  { token: 'field-close', light: '#eeeeee', dark: '#1e1e1e', use: 'Closing field' },
  { token: 'error', light: '#b42318', dark: '#ff8a7a', use: 'Errors' },
  { token: 'focus', light: '#111111', dark: '#f2f2f2', use: 'Focus ring' },
] as const;

const buttonStates = [
  { label: 'Rest', attrs: {} },
  { label: 'Hover', attrs: { 'data-state': 'hover' } },
  { label: 'Pressed', attrs: { 'data-state': 'pressed' } },
  { label: 'Focus', attrs: { 'data-state': 'focus' } },
  { label: 'Disabled', attrs: { disabled: true } },
];

const linkStates = [
  { label: 'Rest', attrs: {} },
  { label: 'Hover', attrs: { 'data-state': 'hover' } },
  { label: 'Focus', attrs: { 'data-state': 'focus' } },
];

// The first site case study, so the card always shows a real picture.
const [pos] = await getSiteCaseStudies();
const card = {
  href: '#',
  title: pos.data.title,
  meta: caseStudyMeta(pos),
  image: pos.data.cover,
  alt: pos.data.coverAlt,
  level: 4 as const,
};
---

<BaseLayout title="Kit · Thu Rein Htet" noindex shell={false}>
  <main class="px-page py-18">
    <div class="flex items-start justify-between gap-6">
      <h1 class="text-head">The kit</h1>
      <ThemeToggle />
    </div>
    <p class="mt-4 max-w-measure text-lead text-muted">
      Every token and base piece in every state, in both themes. This page is hidden from search and
      navigation.
    </p>

    <section class="mt-12" aria-labelledby="toggle-heading">
      <h2 id="toggle-heading" class="text-lead">Theme toggle</h2>
      <p class="mt-2 max-w-measure text-small text-muted">
        It follows the page theme, so it sits here rather than in the panels. Any of these switches the
        page.
      </p>
      <ul class="mt-4 flex flex-wrap gap-8" role="list">
        {
          ['Rest', 'Hover', 'Focus'].map((label) => (
            <li>
              <p class="text-small text-muted">{label}</p>
              <div class="mt-2">
                <ThemeToggle data-state={label === 'Rest' ? undefined : label.toLowerCase()} />
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        themes.map((theme) => (
          <section data-theme={theme} class="bg-bg p-column text-ink" aria-labelledby={`panel-${theme}`}>
            <h2 id={`panel-${theme}`} class="text-head">
              {theme === 'light' ? 'Light theme' : 'Dark theme'}
            </h2>

            <h3 class="mt-12 text-lead">Type</h3>
            <p class="mt-6 font-display text-display">tyson</p>
            <p class="mt-6 font-display text-head">Design that ships as code</p>
            <p class="mt-6 text-lead">Lead text for the opening line of a section.</p>
            <p class="mt-4 max-w-measure text-body">
              Body text in Source Serif 4. I design the screens, then build them, so the thing you
              approve is the thing that ships. <em>Italic for titles</em> and{' '}
              <strong class="font-semibold">semibold for emphasis</strong>.
            </p>
            <p class="mt-4 text-small text-muted">Small text for notes, 13px at the smallest.</p>
            <p class="mt-6 text-lead" lang="my">
              မင်္ဂလာပါ
            </p>

            <h3 class="mt-12 text-lead">Buttons</h3>
            {(['primary', 'secondary'] as const).map((variant) => (
              <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-6" role="list">
                {buttonStates.map((s) => (
                  <li>
                    <p class="text-small text-muted">{s.label}</p>
                    <div class="mt-2">
                      <Button variant={variant} {...s.attrs}>
                        {variant === 'primary' ? 'Get in touch' : 'See the work'}
                      </Button>
                    </div>
                  </li>
                ))}
              </ul>
            ))}
            <div class="mt-6">
              <p class="text-small text-muted">As a link</p>
              <div class="mt-2">
                <Button href="#">Read the case study</Button>
              </div>
            </div>

            <h3 class="mt-12 text-lead">Links</h3>
            <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-6" role="list">
              {linkStates.map((s) => (
                <li>
                  <p class="text-small text-muted">{s.label}</p>
                  <p class="mt-2 text-body">
                    <Link href="#" {...s.attrs}>
                      Behance case study
                    </Link>
                  </p>
                </li>
              ))}
            </ul>
            <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-6" role="list">
              {linkStates.map((s) => (
                <li>
                  <p class="text-small text-muted">{s.label}</p>
                  <p class="mt-2 text-body">
                    <Link href="#" arrow {...s.attrs}>
                      Read the case study
                    </Link>
                  </p>
                </li>
              ))}
            </ul>

            <h3 class="mt-12 text-lead">Fields</h3>
            <div class="mt-6 grid max-w-measure gap-8">
              <Field label="Rest" name={`rest-${theme}`} autocomplete="off" />
              <Field label="Hover" name={`hover-${theme}`} autocomplete="off" data-state="hover" />
              <Field label="Focus" name={`focus-${theme}`} autocomplete="off" data-state="focus" value="Tyson" />
              <Field
                label="With a hint"
                name={`hint-${theme}`}
                type="email"
                autocomplete="off"
                hint="I reply within two working days."
              />
              <Field
                label="Error"
                name={`error-${theme}`}
                type="email"
                autocomplete="off"
                value="tyson@"
                error="Enter an email address like name@example.com."
              />
              <Field
                label="Error with focus"
                name={`error-focus-${theme}`}
                type="email"
                autocomplete="off"
                value="tyson@"
                data-state="focus"
                error="Enter an email address like name@example.com."
              />
              <Field label="Multi line" name={`message-${theme}`} multiline rows={4} hint="A few lines is plenty." />
            </div>

            <h3 class="mt-12 text-lead">Design / Code switch</h3>
            <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-6" role="list">
              <li>
                <p class="text-small text-muted">Design pressed</p>
                <div class="mt-2"><DesignCodeSwitch /></div>
              </li>
              <li>
                <p class="text-small text-muted">Code pressed</p>
                <div class="mt-2"><DesignCodeSwitch value="code" /></div>
              </li>
              <li>
                <p class="text-small text-muted">Hover</p>
                <div class="mt-2"><DesignCodeSwitch state="hover" /></div>
              </li>
              <li>
                <p class="text-small text-muted">Focus</p>
                <div class="mt-2"><DesignCodeSwitch state="focus" /></div>
              </li>
            </ul>
            <div class="mt-6" data-kit-switch>
              <p class="text-small text-muted">Try it</p>
              <div class="mt-2"><DesignCodeSwitch /></div>
              <p class="mt-3 text-small text-muted" aria-live="polite" data-kit-switch-output>
                Showing the Figma design.
              </p>
            </div>

            <h3 class="mt-12 text-lead">Project card</h3>
            <ul class="mt-6 grid gap-8 sm:grid-cols-2" role="list">
              <li>
                <p class="text-small text-muted">Rest</p>
                <div class="mt-2"><ProjectCard {...card} /></div>
              </li>
              <li>
                <p class="text-small text-muted">Hover</p>
                <div class="mt-2"><ProjectCard {...card} data-state="hover" /></div>
              </li>
              <li>
                <p class="text-small text-muted">Focus</p>
                <div class="mt-2"><ProjectCard {...card} data-state="focus" /></div>
              </li>
            </ul>

            <h3 class="mt-12 text-lead">Colour</h3>
            <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3" role="list">
              {colours.map((c) => (
                <li class="bg-surface p-3">
                  <div class="h-18" style={`background-color: var(--color-${c.token})`} />
                  <p class="mt-3 text-small font-semibold">{c.token}</p>
                  <p class="text-small text-muted">{c[theme]}</p>
                  <p class="text-small text-muted">{c.use}</p>
                </li>
              ))}
            </ul>

            <div class="mt-12 grid gap-3 sm:grid-cols-2">
              <p class="bg-accent p-6 text-body text-accent-ink">Text on accent</p>
              <p class="bg-stage p-6 text-body text-stage-ink">Text on the stage</p>
              <p class="bg-field-close p-6 text-body text-ink">Text on the closing field</p>
              <p class="bg-surface p-6 text-body text-error">An error message reads like this.</p>
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<script>
  // Proves the switch's event reaches the page: the line under it follows the choice.
  document.addEventListener('designcode:change', (event) => {
    const { value } = (event as CustomEvent<{ value: 'design' | 'code' }>).detail;
    const output = (event.target as HTMLElement).closest('[data-kit-switch]')?.querySelector('[data-kit-switch-output]');
    if (output) output.textContent = value === 'code' ? 'Showing the coded version.' : 'Showing the Figma design.';
  });
</script>
